# 複製成 .env 後再改。資料庫建立前請先填密碼和 LINE 欄位。

MYSQL_ROOT_PASSWORD=
DB_NAME=jingfeng
DB_USER=jingfeng
DB_PASSWORD=

BACKEND_PORT=38980
DB_PORT=38986

# 逗號分隔的 LINE userId。留空時沒有人能進。
LINE_ALLOWED_USER_IDS=

# 可以改產品與話術的人。這些人要同時列在上面的白名單。
LINE_ADMIN_USER_IDS=

# LINE Login 頻道裡的 LIFF。Channel ID 是 LIFF ID 第一個減號前面的數字。
LIFF_ID=
LIFF_CHANNEL_ID=
